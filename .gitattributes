# Satır sonları: depoda LF; çalışma kopyasında da LF (Windows'ta Prettier/ESLint ile uyumlu)
* text=auto eol=lf

# Windows'a özgü dosyalar CRLF kalsın
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.sqlite binary
*.woff binary
*.woff2 binary
