{
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "topic", "kind", "sensitive", "confidence", "reason"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 80 },
          "topic": { "type": "string", "maxLength": 60 },
          "kind": { "type": "string" },
          "date_hint": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
          "sensitive": { "type": "boolean" },
          "keep_together": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
