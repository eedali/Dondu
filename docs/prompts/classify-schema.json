{
  "name": "classify_files",
  "description": "Return one classification per input file id. Every input id must appear exactly once.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["results"],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "category", "confidence", "sensitive", "reason"],
          "properties": {
            "id": { "type": "string" },
            "category": { "type": "string", "description": "One of the category ids given in the system prompt, or 'uncertain'." },
            "subcategory": { "type": "string", "maxLength": 40 },
            "suggested_name": { "type": "string", "maxLength": 60 },
            "date_hint": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "sensitive": { "type": "boolean" },
            "reason": { "type": "string", "maxLength": 160 }
          }
        }
      }
    }
  }
}
